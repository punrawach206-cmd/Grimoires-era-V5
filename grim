function fit()
    local vp = viewportSize()
    smallScreen = vp.X < 600
    local scale = math.clamp(UIPrefs.Scale, 0.6, 1.5)
    uiScale.Scale = scale
    local w = smallScreen and math.floor(vp.X * 0.94 / scale) or 540
