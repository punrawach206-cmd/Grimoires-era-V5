local function equippedNames()
    local set = {}
    local function scan(container)
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") then
                    set[tool.Name] = true
                    local id = tool:GetAttribute("ItemId")
                    if type(id) == "string" then set[id] = true end
                end
            end
        end
    end
    scan(LocalPlayer.Character)
    scan(LocalPlayer:FindFirstChildOfClass("Backpack"))
    return set
end

-- Same exclusions as the dump's getSellValue (220166), plus: rarity cap,
-- bound copies, grimoires, consumables and anything currently held as a tool.
local function sellableAmount(name, entry, held)
    local data = inventoryData()
    local item = data and data[name]
    if type(name) ~= "string" or type(item) ~= "table" or held[name] then return 0 end
    if item.NonSellable == true or item.GamepassItem == true or item.Rarity == "LIMITED" or name == "Combat" then return 0 end
    if item.Type == "Grimoire" or item.Type == "Consumable" then return 0 end
    if (tonumber(item.SellValue) or 0) <= 0 then return 0 end
    local rank = nil
    for index, rarity in ipairs(Config.SellRarities) do
        if rarity == item.Rarity then rank = index end
    end
    if rank == nil or rank > Options.SellMaxRarity then return 0 end
    local amount = entryAmount(entry)
    local bound = math.clamp(math.floor(tonumber(entry.Bound) or 0), 0, amount)
    return amount - bound
end

function sellNow()
    runTrip("sell", function()
        local remote = resolve(Config.InventoryRemote)
        if not remote then
            setStatus("sell", "Inventory remote not found: " .. Config.InventoryRemote)
            return
        end
        local tried, sold, limit = {}, 0, 100
        while alive and limit > 0 do
            limit = limit - 1
            local inv, why = inventoryEntries()
            if not inv then
                setStatus("sell", tostring(why))
                break
            end
            local held = equippedNames()
            local pickSlot, pickName, pickAmount = nil, nil, nil
            for slot, entry in pairs(inv) do
                if type(entry) == "table" then
                    local id = tostring(slot) .. "|" .. tostring(entry.Item)
                    local amount = (tried[id] or 0) < 2 and sellableAmount(entry.Item, entry, held) or 0
                    if amount > 0 then
                        pickSlot, pickName, pickAmount = slot, entry.Item, amount
                        tried[id] = (tried[id] or 0) + 1
                        break
                    end
                end
            end
            if pickSlot == nil then
                break
            end
            fire(remote, "sell", pickSlot, pickAmount)
            sold = sold + 1
            setStatus("sell", string.format("selling %s x%d", tostring(pickName), pickAmount))
            task.wait(0.3)
        end
        setStatus("sell", string.format("sell finished, %d sell request(s) sent", sold))
        notify(SCRIPT_NAME, string.format("Sell finished: %d request(s)", sold))
    end)
end

-- Codes -----------------------------------------------------------------------
local codesWired = false
local function wireCodesReply()
    if codesWired then return end
    local remote = resolve(Config.CodesRemote)
    if remote and remote:IsA("RemoteEvent") then
        codesWired = true
        track(remote.OnClientEvent:Connect(function(message)
            logEvent("info", "code reply: " .. tostring(message))
        end))
    end
end

local function parseCodes(text)
    local codes, seen = {}, {}
    for token in string.gmatch(tostring(text), "[^%s,;]+") do
        if #token <= 128 and not seen[token] then
            seen[token] = true
            table.insert(codes, token)
        end
    end
    return codes
end

function redeemAllCodes()
    local codes = parseCodes(Options.CodesText)
    if #codes == 0 then
        setStatus("codes", "no codes entered (one per line)")
        return
    end
    local remote = resolve(Config.CodesRemote)
    if not remote then
        setStatus("codes", "Codes remote not found: " .. Config.CodesRemote)
        return
    end
    wireCodesReply()
    task.spawn(function()
        local okGroup, inGroup = pcall(LocalPlayer.IsInGroupAsync, LocalPlayer, Config.CodesGroupId)
        if okGroup and inGroup == false then
            setStatus("codes", "codes need group " .. Config.CodesGroupId .. " membership (client check in the dump)")
            return
        end
        local sentAt = {}
        for index, code in ipairs(codes) do
            if not alive then break end
            -- stay under WrongPerMinute even if every code were wrong
            local now = os.clock()
            local recent = {}
            for _, t in ipairs(sentAt) do
                if now - t < 60 then table.insert(recent, t) end
            end
            sentAt = recent
            if #sentAt >= Config.CodesWrongPerMinute then
                local waitFor = 60 - (now - sentAt[1]) + 0.5
                setStatus("codes", string.format("pausing %d s for the per-minute limit", math.ceil(waitFor)))
                task.wait(waitFor)
            end
            fire(remote, code)
            table.insert(sentAt, os.clock())
            setStatus("codes", string.format("sent %d/%d", index, #codes))
            task.wait(Config.CodesRequestGap + 0.3)
        end
        setStatus("codes", string.format("finished, %d code(s) sent (see the log for replies)", #codes))
        notify(SCRIPT_NAME, string.format("Codes done: %d sent", #codes))
    end)
end

