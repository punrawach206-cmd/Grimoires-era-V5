-- Quest giver (used by "Follow quest" when no quest is active).
-- Path copied from the dump: the quest dialogue's last Confirm sends
-- Quests:FireServer("giveQuest", <NPC model Name>, nil) (DUMP ~line 127407).
-- Whether the server accepts that without the dialogue is unverified, so the
-- dialogue itself is the fallback (prompt, then Confirm presses).
--------------------------------------------------------------------------
local Giver = { interacts = nil, progression = nil, models = {}, blockedUntil = {}, lastTry = 0 }

local function requireByPath(path)
    local node = resolve(path)
    if node and node:IsA("ModuleScript") then
        local ok, result = pcall(require, node)
        if ok and type(result) == "table" then
            return result
        end
    end
    return nil
end

-- Returns (set of active quest Ids, count). A missing attribute reads as an
-- empty log, the same as the dump's own `or "[]"`.
local function activeQuests()
    local raw = LocalPlayer:GetAttribute(Config.ActiveQuestsAttribute) or "[]"
    local ids, count = {}, 0
    local ok, list = pcall(HttpService.JSONDecode, HttpService, raw)
    if ok and type(list) == "table" then
        for _, quest in ipairs(list) do
            count = count + 1
            if type(quest) == "table" and quest.Id ~= nil then
                ids[tostring(quest.Id)] = true
            end
        end
    end
    return ids, count
end

local function questNeeded()
    local _, count = activeQuests()
    return count == 0
end

local function findGiverModel(key)
    local cached = Giver.models[key]
    if cached and cached.Parent and getRoot(cached) then
        return cached
    end
    local found = Workspace:FindFirstChild(key, true)
    if found and found:IsA("Model") and getRoot(found) then
        Giver.models[key] = found
        return found
    end
    return nil
end

-- Highest-requirement quest I can take now: not active, not blocked, level
-- and Requires satisfied, free (not PaidQuest), PrimaryQuest, model present.
local function pickGiver()
    Giver.interacts = Giver.interacts or requireByPath(Config.InteractsModule)
    Giver.progression = Giver.progression or requireByPath(Config.ProgressionModule)
    if not Giver.interacts then
        return nil, "Interacts module unavailable: " .. Config.InteractsModule
    end
    if not Giver.progression or type(Giver.progression.MeetsLevelRequirement) ~= "function" then
        return nil, "Progression.MeetsLevelRequirement unavailable"
    end
    local active, count = activeQuests()
    if count >= Config.MaxActiveQuests then
        return nil, "quest log is full"
    end
    local best = nil
    local givers, blocked, missingModel = 0, 0, 0
    for key, data in pairs(Giver.interacts) do
        local qd = type(data) == "table" and data.InteractType == "QuestGiver" and data.QuestData or nil
        if type(qd) == "table" and type(qd.Quest) == "string" and not qd.PaidQuest
            and qd.PrimaryQuest ~= false and not active[qd.Quest] then
            local doneKey = Config.QuestDonePrefix .. qd.Quest
            local requires = qd.Requires
            local doneBlocks = qd.CanRepeat ~= true and LocalPlayer:GetAttribute(doneKey) == true
            local requiresBlocks = type(requires) == "string" and requires ~= ""
                and LocalPlayer:GetAttribute(Config.QuestDonePrefix .. requires) ~= true
            local okLevel, meets = pcall(Giver.progression.MeetsLevelRequirement, LocalPlayer, qd.LvlReq)
            if not doneBlocks and not requiresBlocks and okLevel and meets == true then
                givers = givers + 1
                if (Giver.blockedUntil[key] or 0) > os.clock() then
                    blocked = blocked + 1
                else
                    local model = findGiverModel(key)
                    if model == nil then
                        missingModel = missingModel + 1
                    else
                        local req = tonumber(qd.LvlReq) or 0
                        if best == nil or req > best.req or (req == best.req and key < best.key) then
                            best = { key = key, quest = qd.Quest, req = req, model = model,
                                name = tostring(data.DisplayName or key) }
                        end
                    end
                end
            end
        end
    end
    if best then
        return best, nil
    end
    return nil, string.format("no quest giver available (eligible %d, skipped %d, model not found %d)",
        givers, blocked, missingModel)
end

local function findConfirmButton()
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return nil end
    for _, inst in ipairs(playerGui:GetDescendants()) do
        if inst.Name == "Confirm" and inst:IsA("GuiButton") then
            local frame = inst.Parent
            -- DUMP dialogue frame (~line 127506): children Confirm, Cancel, Desc.
            if frame and frame:IsA("GuiObject") and frame.Visible
                and frame:FindFirstChild("Cancel") and frame:FindFirstChild("Desc") then
                return inst, frame:FindFirstChild("Cancel")
            end
        end
    end
    return nil
end

local function waitAccepted(quest, seconds)
    local deadline = os.clock() + seconds
    repeat
        if activeQuests()[quest] then return true end
        task.wait(0.15)
    until os.clock() >= deadline or not alive
    return activeQuests()[quest] == true
end

local function acceptViaDialogue(pick)
    if type(fireproximityprompt) ~= "function" then
        return false, "fireproximityprompt unavailable"
    end
    if type(firesignal) ~= "function" then
        return false, "firesignal unavailable"
    end
    local prompt = nil
    for _, d in ipairs(pick.model:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            prompt = d
            break
        end
    end
    if not prompt then
        return false, "giver has no ProximityPrompt"
    end
    pcall(fireproximityprompt, prompt)
    local deadline = os.clock() + 9
    local presses = 0
    while os.clock() < deadline and presses < 12 and alive do
        local confirm = findConfirmButton()
        if confirm then
            pcall(firesignal, confirm.MouseButton1Click)
            presses = presses + 1
            task.wait(0.45)
        else
            task.wait(0.25)
        end
        if activeQuests()[pick.quest] then
            return true
        end
    end
    local _, cancel = findConfirmButton()
    if cancel then
        pcall(firesignal, cancel.MouseButton1Click)
    end
    return activeQuests()[pick.quest] == true, "dialogue did not accept"
end

-- One tick: fly to the giver, then accept. Returns the status text.
local function questGiverStep(root)
    local remote = resolve(Config.QuestRemote)
    if remote == nil then
        Mover.goal = nil
        return "Quests remote not found: " .. tostring(Config.QuestRemote)
    end
    local pick, reason = pickGiver()
    if not pick then
        Mover.goal = nil
        return reason
    end
    local npcRoot = getRoot(pick.model)
    local flat = Vector3.new(root.Position.X - npcRoot.Position.X, 0, root.Position.Z - npcRoot.Position.Z)
    flat = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
    local stand = npcRoot.Position + flat * Config.GiverStandoffStuds
    Mover.goal = CFrame.lookAt(stand, Vector3.new(npcRoot.Position.X, stand.Y, npcRoot.Position.Z))
    local dist = (npcRoot.Position - root.Position).Magnitude
    if dist > Config.GiverStandoffStuds + 2 then
        return string.format("flying to quest giver %s (%d studs)", pick.name, math.floor(dist))
    end
    if os.clock() - Giver.lastTry < 2 then
        return "at quest giver " .. pick.name
    end
    Giver.lastTry = os.clock()

    fire(remote, "giveQuest", pick.key, nil)
    if waitAccepted(pick.quest, 1.5) then
        return "accepted quest " .. pick.quest .. " from " .. pick.name
    end
    local ok, why = acceptViaDialogue(pick)
    if ok then
        return "accepted quest " .. pick.quest .. " through the dialogue"
    end
    Giver.blockedUntil[pick.key] = os.clock() + 60
    return string.format("%s did not accept %s (%s); skipping it for 60 s", pick.name, pick.quest, tostring(why))
end

spawnGuarded("farm", function()
    local lastSwing, lastSkill = 0, 0
    local current, lastMode = nil, Options.FarmMode
    while alive do
        if State.AutoFarm and not Activity.chestBusy and not Activity.tripBusy then
            local char, root, hum = localChar()
