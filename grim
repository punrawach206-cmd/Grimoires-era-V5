local function pickAimTarget(camera)
    local origin = touchOnly and (camera.ViewportSize / 2) or UserInputService:GetMouseLocation()
    local pool = livePlayerChars()
    for _, npc in ipairs(liveNpcs()) do table.insert(pool, npc) end
    local best, bestDist = nil, Tune.AimFovPixels
