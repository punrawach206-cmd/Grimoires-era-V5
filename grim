                        end
                    else
                        local area = Options.FarmMode == 3 and questAreaPosition() or nil
                        if area then
                            Mover.goal = CFrame.new(area + Vector3.new(0, 6, 0))
                            setStatus("farm", "flying to the quest area | " .. tostring(note))
                        else
                            Mover.goal = nil
                            setStatus("farm", tostring(note or "no mob in range"))
                        end
                    end
                end
            end
        elseif not Activity.chestBusy and not Activity.tripBusy then
            Mover.goal = nil
        end
        task.wait(jitter(math.min(Tune.FarmTickSeconds, math.max(Tune.AttackIntervalSeconds, 0.03))))
    end
