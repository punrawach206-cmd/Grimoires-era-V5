-- Activity log (newest last). Errors are mirrored in a second list for the
-- Error panel. Log.onChange is set by the UI.
local Log = { entries = {}, errors = {}, onChange = nil }
local LOG_MAX = 200
local function logEvent(level, text)
    local entry = { time = os.date("%H:%M:%S"), level = level, text = tostring(text) }
    table.insert(Log.entries, entry)
    if #Log.entries > LOG_MAX then
        table.remove(Log.entries, 1)
    end
    if level == "error" then
        table.insert(Log.errors, entry)
        if #Log.errors > LOG_MAX then
            table.remove(Log.errors, 1)
        end
    end
    if Log.onChange then
        pcall(Log.onChange, entry)
    end
end

local Prefs = { Notify = true }
