-- Auto chest: fly to the prompt, press it, then wait out the server's
-- OpenDelay before leaving (leaving early was the likely reason it failed).
--------------------------------------------------------------------------
local bossPrompts = {}
local function trackPrompt(inst)
    if inst:IsA("ProximityPrompt") and inst.Name == Config.BossChestPromptName then
        bossPrompts[inst] = true
    end
end
for _, inst in ipairs(Workspace:GetDescendants()) do
    trackPrompt(inst)
