    Activity.tripBusy = true
    task.spawn(function()
        local ok, err = pcall(fn)
        Mover.goal = nil
        Activity.tripBusy = false
        if not ok then
            logEvent("error", label .. ": " .. tostring(err))
        end
    end)
end

