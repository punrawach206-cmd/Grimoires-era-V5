                        local state = char:GetAttribute(Config.CharacterStateAttribute)
                        local canSwing = (State.RapidM1 or state == nil or state == "Idle")
                            and char:GetAttribute(Config.CharacterBlockingAttribute) ~= true
                        local now = os.clock()
