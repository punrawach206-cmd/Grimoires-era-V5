local function flyNear(model, standoff, timeout)
    local deadline = os.clock() + timeout
    while alive and os.clock() < deadline do
        local char, root = localChar()
        local npcRoot = model.Parent and getRoot(model)
        if not char or not npcRoot then
            Mover.goal = nil
            return false
        end
        local flat = Vector3.new(root.Position.X - npcRoot.Position.X, 0, root.Position.Z - npcRoot.Position.Z)
        flat = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
        local stand = npcRoot.Position + flat * standoff
        Mover.goal = CFrame.lookAt(stand, Vector3.new(npcRoot.Position.X, stand.Y, npcRoot.Position.Z))
        if (npcRoot.Position - root.Position).Magnitude <= standoff + 2 then
            return true
        end
        task.wait(0.1)
    end
    return false
end

local function runTrip(label, fn)
    if Activity.tripBusy then
        logEvent("info", label .. ": another trip is still running")
        return
