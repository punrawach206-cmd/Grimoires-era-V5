-- Search and Favorites rebuild rows from the registry ----------------------------
local function clearContainer(page)
    for _, child in ipairs(page:GetChildren()) do
        if child:IsA("GuiObject") then
            child:Destroy()
        end
    end
    pageOrder[page] = 0
    pageRepaints[page] = {}
end

local function runSearch()
    if suppressSearch then
        return
    end
    local query = string.lower(searchBox.Text)
    query = (string.gsub(query, "^%s+", ""))
    query = (string.gsub(query, "%s+$", ""))
    if query == "" then
        if currentPage == "Search" then
            selectPage(lastRealPage)
        end
        return
    end
    local results = pages.Search
    clearContainer(results)
    addTitle(results, "Results for: " .. query)
    local count = 0
    for _, entry in ipairs(Registry) do
        if string.find(entry.text, query, 1, true) then
            count = count + 1
            if count <= 40 then
                entry.build(results)
            end
        end
    end
    if count == 0 then
        addNote(results, "Nothing matches that.", C.muted)
    end
    selectPage("Search")
end
searchBox:GetPropertyChangedSignal("Text"):Connect(runSearch)

rebuildFavorites = function()
    local page = pages.Favorites
    clearContainer(page)
    addTitle(page, "Favorites")
    local count = 0
    for _, entry in ipairs(Registry) do
        if UIPrefs.Favorites[entry.id] then
            count = count + 1
            entry.build(page)
        end
    end
    if count == 0 then
        addNote(page, "Tap the star on any setting to pin it here.", C.muted)
    end
end

