-- Persistence (executor files when available, memory otherwise) ----------------
Store = { file = "GrimoiresByPUN_prefs.json", data = {} }
local function storeLoad()
    if type(isfile) == "function" and type(readfile) == "function" then
        local ok, raw = pcall(function()
            if isfile(Store.file) then
                return readfile(Store.file)
            end
            return nil
        end)
        if ok and type(raw) == "string" and raw ~= "" then
            local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
            if ok2 and type(data) == "table" then
                return data
            end
        end
    end
    return {}
end
function saveStore()
    Store.data.favorites = UIPrefs.Favorites
    Store.data.ui = {
        Animate = UIPrefs.Animate, Compact = UIPrefs.Compact,
        Scale = UIPrefs.Scale, Notify = Prefs.Notify,
    }
    if type(writefile) == "function" then
        pcall(function()
            writefile(Store.file, HttpService:JSONEncode(Store.data))
        end)
    end
end
Store.data = storeLoad()
if type(Store.data.favorites) == "table" then
    for id, on in pairs(Store.data.favorites) do
        if on == true and type(id) == "string" then
            UIPrefs.Favorites[id] = true
        end
    end
end
if type(Store.data.ui) == "table" then
    local ui = Store.data.ui
    if type(ui.Animate) == "boolean" then UIPrefs.Animate = ui.Animate end
    if type(ui.Compact) == "boolean" then UIPrefs.Compact = ui.Compact end
    if type(ui.Notify) == "boolean" then Prefs.Notify = ui.Notify end
    if type(ui.Scale) == "number" and ui.Scale == ui.Scale then
        UIPrefs.Scale = math.clamp(ui.Scale, 0.6, 1.5)
    end
end
if type(Store.data.presets) ~= "table" then
    Store.data.presets = {}
end

