-- Runs fn in its own thread; an error is logged and the loop restarts after 2 s.
local function spawnGuarded(name, fn)
    task.spawn(function()
        while alive do
            local ok, err = pcall(fn)
            if ok or not alive then
                break
            end
            logEvent("error", name .. ": " .. tostring(err))
            task.wait(2)
        end
    end)
end

local statusLines, statusLabel = {}, nil
local lastStatusShape = {}
local function setStatus(key, text)
    statusLines[key] = text
    local shape = string.gsub(tostring(text), "%d+", "#")
    if lastStatusShape[key] ~= shape then
        lastStatusShape[key] = shape
        logEvent("info", key .. ": " .. tostring(text))
    end
    if statusLabel then
        local parts = {}
        for _, k in ipairs({ "farm", "rapid", "skills", "chest", "quest", "stats", "potion", "dungeon", "shop", "sell", "codes" }) do
            if statusLines[k] then
                table.insert(parts, k .. ": " .. statusLines[k])
            end
        end
        statusLabel.Text = table.concat(parts, "\n")
    end
end

