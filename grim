-- getFn / setFn read and write the value; gateFn returns a reason string
-- (feature unavailable) or nil, and a gated toggle always reads OFF.
function addToggle(page, name, desc, getFn, setFn, gateFn, idOverride)
    local id = idOverride or (page.Name .. "/" .. name)
    registerSetting(page, id, name .. " " .. (desc or ""), function(p)
        addToggle(p, name, desc, getFn, setFn, gateFn, id)
    end)
    local row = makeRow(page, 62)
    local descLabel = nameAndDesc(row, name, desc, 110)

    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(60, 30)
    button.Position = UDim2.new(1, -70, 0.5, -15)
    button.BorderSizePixel = 0
    button.Font = Enum.Font.GothamMedium
    button.TextSize = 13
    button.TextColor3 = C.text
    button.Parent = row
    corner(button, 8)
    stroke(button)
    addStar(row, id, -98)

    local function paint()
        local reason = gateFn and gateFn()
        local on = getFn() == true and reason == nil
        descLabel.Text = reason or desc or ""
        descLabel.TextColor3 = reason and C.red or C.muted
        button.Text = on and "ON" or "OFF"
        tween(button, { BackgroundColor3 = on and C.red or C.panel2 })
    end
    button.MouseButton1Click:Connect(function()
        if gateFn and gateFn() then
            setFn(false)
        else
            setFn(not getFn())
        end
        paint()
    end)
    register(page, paint)
    paint()
end

