local function playSplash()
    if not UIPrefs.Animate then
        return
    end
    local splash = Instance.new("Frame")
    splash.Name = "Splash"
    splash.AnchorPoint = Vector2.new(0.5, 0.5)
    splash.Position = UDim2.fromScale(0.5, 0.5)
    splash.Size = UDim2.fromOffset(280, 160)
    splash.BackgroundColor3 = C.bg
    splash.BorderSizePixel = 0
    splash.Parent = gui
    corner(splash, 12)
    stroke(splash, C.red, 1.5)

    local title = makeLabel(splash, "PUNPUN  /  GRIMOIRES", 16, C.red, true)
    title.TextXAlignment = Enum.TextXAlignment.Center
    title.Position = UDim2.fromOffset(0, 14)
    title.Size = UDim2.new(1, 0, 0, 24)

    local dots = {}
    for i = 1, 8 do
        local angle = (i - 1) / 8 * math.pi * 2
        local dot = Instance.new("Frame")
        dot.AnchorPoint = Vector2.new(0.5, 0.5)
        dot.Size = UDim2.fromOffset(8, 8)
        dot.Position = UDim2.new(0.5, math.cos(angle) * 20, 0, 78 + math.sin(angle) * 20)
        dot.BackgroundColor3 = C.red
        dot.BorderSizePixel = 0
        dot.Parent = splash
        corner(dot, 4)
        dots[i] = dot
    end

    local statusText = makeLabel(splash, "Loading modules...", 12, C.muted, false)
    statusText.TextXAlignment = Enum.TextXAlignment.Center
    statusText.Position = UDim2.fromOffset(0, 112)
    statusText.Size = UDim2.new(1, 0, 0, 18)

    local barTrack = Instance.new("Frame")
    barTrack.Size = UDim2.fromOffset(220, 6)
    barTrack.Position = UDim2.new(0.5, -110, 0, 138)
    barTrack.BackgroundColor3 = C.panel2
    barTrack.BorderSizePixel = 0
    barTrack.Parent = splash
    corner(barTrack, 3)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = C.red
    fill.BorderSizePixel = 0
    fill.Parent = barTrack
    corner(fill, 3)
    tween(fill, { Size = UDim2.fromScale(1, 1) }, 1.5)

    local messages = { "Loading modules...", "Reading the dump values...", "Building the menu...", "Ready" }
    for frame = 1, 20 do
        if not alive then
            break
        end
        for i, dot in ipairs(dots) do
            dot.BackgroundTransparency = ((frame - i) % 8) / 8
        end
        statusText.Text = messages[math.min(#messages, 1 + math.floor((frame - 1) / 5))]
        task.wait(0.08)
    end
    splash:Destroy()
end

