function liveNpcs()
    local list = {}
    local folder = resolve(Config.MobFolder)
    if not folder then return list end
    for _, model in ipairs(folder:GetChildren()) do
        if model:IsA("Model")
            and not CollectionService:HasTag(model, Config.MobSkipTag)
            and isAlive(model) and getRoot(model) then
            local owner = model:GetAttribute(Config.MobOwnerAttribute)
            if owner == nil or owner == LocalPlayer.UserId then
                table.insert(list, model)
            end
        end
    end
    return list
end

function livePlayerChars()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and isAlive(plr.Character) and getRoot(plr.Character) then
            table.insert(list, plr.Character)
        end
    end
    return list
end

local function nearest(models, origin, maxRange)
    local best, bestDist = nil, maxRange
    for _, model in ipairs(models) do
        local d = (getRoot(model).Position - origin).Magnitude
        if d < bestDist then
            best, bestDist = model, d
        end
    end
    return best
end

local function mobName(model)
    local display = model:GetAttribute(Config.MobDisplayAttribute)
    return string.lower(tostring(display or model.Name))
end

local function questText()
    local parts = {}
    for _, attr in ipairs({ Config.QuestStepTextAttribute, Config.QuestNameAttribute, Config.QuestCurrentAttribute }) do
        local value = LocalPlayer:GetAttribute(attr)
        if type(value) == "string" and value ~= "" then
            table.insert(parts, value)
        end
    end
    return table.concat(parts, " ")
end

local function questDone()
    local progress = tonumber(LocalPlayer:GetAttribute(Config.QuestProgressAttribute)) or 0
    local goal = tonumber(LocalPlayer:GetAttribute(Config.QuestGoalAttribute)) or 0
    return goal > 0 and progress >= goal
end

function questAreaPosition()
    for _, attr in ipairs({ Config.QuestAreaAttribute, Config.QuestTargetAttribute }) do
        local value = LocalPlayer:GetAttribute(attr)
        if typeof(value) == "Vector3" then
            return value
        end
    end
    return nil
end

-- Returns (model or nil, note).
function chooseMob(models, origin, maxRange)
    local mode = Options.FarmMode
    if mode == 2 then
        return nearest(models, origin, maxRange), nil
    end

    if mode == 1 then
        local myLevel = tonumber(LocalPlayer:GetAttribute(Config.PlayerLevelAttribute))
        if myLevel == nil then
            return nearest(models, origin, maxRange), "no " .. Config.PlayerLevelAttribute .. " attribute, using nearest"
        end
        local limit = myLevel + Tune.LevelMargin
        local best, bestLevel, bestDist = nil, nil, math.huge
        local anyLevel = false
        for _, model in ipairs(models) do
            local d = (getRoot(model).Position - origin).Magnitude
            local level = tonumber(model:GetAttribute(Config.MobLevelAttribute))
            if level ~= nil then
                anyLevel = true
            end
            local bossBlocked = Options.SkipBosses and model:GetAttribute(Config.MobBossAttribute) == true
            if d <= maxRange and level ~= nil and level <= limit and not bossBlocked then
                if best == nil or level > bestLevel or (level == bestLevel and d < bestDist) then
                    best, bestLevel, bestDist = model, level, d
                end
            end
        end
        if best then
            return best, string.format("Lv.%d (you %d)", bestLevel, myLevel)
        end
        if not anyLevel and #models > 0 then
            return nearest(models, origin, maxRange), "mobs have no " .. Config.MobLevelAttribute .. ", using nearest"
        end
        return nil, string.format("no mob at or below Lv.%d in range", limit)
    end

    local text = string.lower(questText())
    if questDone() then
        return nil, "quest objective complete (turn in or accept the next one)"
    end
    if text == "" then
        return nil, "no quest text yet (accept a quest first)"
    end
    local matches = {}
    for _, model in ipairs(models) do
        local name = mobName(model)
        local id = string.lower(tostring(model:GetAttribute(Config.MobIdAttribute) or ""))
        if (#name >= 3 and string.find(text, name, 1, true))
            or (#id >= 3 and string.find(text, id, 1, true)) then
            table.insert(matches, model)
        end
    end
    local pick = nearest(matches, origin, maxRange)
    if pick then
        return pick, "quest: " .. text
    end
    return nil, "no mob in range matches quest text: " .. text
end

function behindGoal(model)
    local mRoot = getRoot(model)
    local pos = (mRoot.CFrame * CFrame.new(0, 0, standoffStuds())).Position
    return CFrame.lookAt(pos, Vector3.new(mRoot.Position.X, pos.Y, mRoot.Position.Z))
end

