    if minimized then
        root.Size = UDim2.fromOffset(MINIMIZED_W, HEADER_H)
    else
        root.Size = UDim2.fromOffset(w, h)
    end
    if firstFit then
        firstFit = false
        winPos = Vector2.new(math.floor((vp.X - w * scale) / 2), math.floor((vp.Y - h * scale) / 2))
    end
    winPos = clampWindow(winPos)
    root.Position = UDim2.fromOffset(winPos.X, winPos.Y)
