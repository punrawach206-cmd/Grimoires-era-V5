-- Buys Tune.PotionBuyCount of the chosen potion. The client's own Yens check
-- is copied; the purchase is verified by the Yens attribute dropping.
function buyPotions()
    runTrip("shop", function()
        local remote = resolve(Config.ItemShopRemote)
        if not remote then
            setStatus("shop", "ItemShop remote not found: " .. Config.ItemShopRemote)
            return
        end
        local potion = shopChoices()[Options.BuyPotion]
        local model = sellerModel()
        if model and not flyNear(model, Config.GiverStandoffStuds, 40) then
            setStatus("shop", "could not reach the Item Seller, trying remotely")
        end
        local data = inventoryData()
        local price = data and data[potion.shop] and tonumber(data[potion.shop].Price) or nil
        local bought = 0
        for i = 1, math.floor(Tune.PotionBuyCount) do
            if not alive then break end
            local yens = tonumber(LocalPlayer:GetAttribute(Config.YensAttribute)) or 0
            if price and yens < price then
                setStatus("shop", string.format("not enough Yens for %s (need %d)", potion.label, price))
                break
            end
            fire(remote, potion.shop)
            local deadline = os.clock() + 1.5
            local spent = false
            repeat
                task.wait(0.1)
                spent = (tonumber(LocalPlayer:GetAttribute(Config.YensAttribute)) or 0) < yens
            until spent or os.clock() >= deadline
            if not spent then
                setStatus("shop", "server did not take the purchase (open the shop once with Go to shop)")
                break
            end
            bought = bought + 1
            task.wait(jitter(0.3))
        end
        if bought > 0 then
            setStatus("shop", string.format("bought %d x %s", bought, potion.label))
            notify(SCRIPT_NAME, string.format("Bought %d x %s", bought, potion.label))
        end
    end)
end

