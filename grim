Items = { utils = nil, data = nil, lastPotion = 0, lastDungeon = 0 }

local function inventoryData()
    Items.data = Items.data or requireByPath(Config.InventoryDataModule)
    return Items.data
end

-- Inventory attribute -> table of entries ({ Item, Amount, Bound, ... }) keyed by slot.
local function inventoryEntries()
    Items.utils = Items.utils or requireByPath(Config.UtilsModule)
    if not Items.utils or type(Items.utils.fastDecode) ~= "function" then
        return nil, "Utils.fastDecode unavailable: " .. Config.UtilsModule
    end
    local raw = LocalPlayer:GetAttribute(Config.InventoryAttribute) or "[]"
    local ok, decoded = pcall(Items.utils.fastDecode, raw)
    if not ok or type(decoded) ~= "table" then
        return nil, "Inventory attribute did not decode"
    end
    return decoded, nil
end

local function entryAmount(entry)
    return math.max(1, math.floor(tonumber(entry.Amount) or 1))
end

-- Finds the slot holding any of `keys`. Returns (slot, amount) or nil.
local function findItemSlot(keys)
    local inv = inventoryEntries()
    if not inv then
        return nil
    end
    for slot, entry in pairs(inv) do
        if type(entry) == "table" then
            for _, key in ipairs(keys) do
                if entry.Item == key then
                    return slot, entryAmount(entry)
                end
            end
        end
    end
    return nil
end

local function potionCount(keys)
    local inv = inventoryEntries()
    local total = 0
    if inv then
        for _, entry in pairs(inv) do
            if type(entry) == "table" then
                for _, key in ipairs(keys) do
                    if entry.Item == key then
                        total = total + entryAmount(entry)
                    end
                end
            end
        end
    end
    return total
end

function potionNames(kind)
    local names = {}
    for _, potion in ipairs(Config.Potions[kind]) do
        table.insert(names, potion.label)
    end
    return names
end

