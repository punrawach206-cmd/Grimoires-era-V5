local function resolve(path)
    if path == nil then
        return nil, "unset"
    end
    local node = game
    for part in string.gmatch(path, "[^%.]+") do
        node = node:FindFirstChild(part)
        if node == nil then
            return nil, "not found: " .. path
        end
    end
    return node, "ok"
end

local function fire(remote, ...)
    if remote:IsA("RemoteEvent") then
        remote:FireServer(...)
        return true
    elseif remote:IsA("RemoteFunction") then
        local args = table.pack(...)
        task.spawn(function()
            pcall(remote.InvokeServer, remote, table.unpack(args, 1, args.n))
        end)
        return true
    end
    return false
end

local function getRoot(model)
    return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
end

local function isAlive(model)
    local hum = model and model:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0 and model.Parent ~= nil
end

local function localChar()
    local char = LocalPlayer.Character
    if char and isAlive(char) and getRoot(char) then
        return char, getRoot(char), char:FindFirstChildOfClass("Humanoid")
    end
    return nil
end

local function gateRemote(path, label)
    local remote, status = resolve(path)
    if remote == nil then
        return nil, label .. " " .. status
    end
    return remote, nil
end

local function standoffStuds()
    local maxReach = Config.M1BoxOffset + Config.M1BoxDepth / 2
    return math.clamp(Tune.FarmStandoffStuds, 2, maxReach)
end

--------------------------------------------------------------------------
-- Mover: smooth flight toward Mover.goal (a CFrame), no teleporting.
-- Character parts are made non-colliding only while a goal is active.
--------------------------------------------------------------------------
local Mover = { goal = nil, noclip = {} }

local function restoreCollision()
    for part in pairs(Mover.noclip) do
        if part.Parent then
            part.CanCollide = true
        end
        Mover.noclip[part] = nil
    end
end

track(RunService.Heartbeat:Connect(function(dt)
    local goal = Mover.goal
    local char, root = localChar()
    if goal == nil or char == nil then
        if next(Mover.noclip) ~= nil then
            restoreCollision()
        end
        return
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            Mover.noclip[part] = true
            part.CanCollide = false
        end
    end
    local delta = goal.Position - root.Position
    local dist = delta.Magnitude
    local step = Tune.FlySpeed * dt
    local newPos = goal.Position
    if dist > step then
        newPos = root.Position + delta.Unit * step
    end
    local flatLook = Vector3.new(goal.LookVector.X, 0, goal.LookVector.Z)
    if flatLook.Magnitude < 0.001 then
        flatLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    end
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.lookAt(newPos, newPos + flatLook)
end))

