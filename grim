local settingsPage = pages.Settings

-- Presets: State (except Black Screen), Options and Tune as JSON.
local function deepCopy(value)
    if type(value) ~= "table" then
        return value
    end
    local out = {}
    for k, v in pairs(value) do
        out[k] = deepCopy(v)
    end
    return out
end

local function snapshot()
    local st = {}
    for k, v in pairs(State) do
        if k ~= "BlackScreen" then
            st[k] = v
        end
    end
    return { state = st, options = deepCopy(Options), tune = deepCopy(Tune) }
end
local defaultSnapshot = snapshot()

local function clampIndex(value, count)
    return math.clamp(math.floor(tonumber(value) or 1), 1, count)
end

local function okNumber(v)
    return type(v) == "number" and v == v and math.abs(v) < 1e7
end

local function applySnapshot(snap)
    if type(snap) ~= "table" then
        return false
    end
    if type(snap.state) == "table" then
        for k, v in pairs(snap.state) do
            if State[k] ~= nil and type(v) == "boolean" and k ~= "BlackScreen" then
                State[k] = v
            end
        end
    end
    if type(snap.tune) == "table" then
        for k, v in pairs(snap.tune) do
            if Tune[k] ~= nil and okNumber(v) then
                Tune[k] = v
            end
        end
    end
    if type(snap.options) == "table" then
        for k, v in pairs(snap.options) do
            if k == "SkillKeys" and type(v) == "table" then
                for key, on in pairs(v) do
                    if Options.SkillKeys[key] ~= nil and type(on) == "boolean" then
                        Options.SkillKeys[key] = on
                    end
                end
            elseif Options[k] ~= nil and type(v) == type(Options[k]) and (type(v) ~= "number" or okNumber(v)) then
                Options[k] = v
            end
        end
    end
    for key, range in pairs(StepperRanges) do
        if Tune[key] ~= nil then
            Tune[key] = math.clamp(Tune[key], range[1], range[2])
        end
    end
    Options.FarmMode = clampIndex(Options.FarmMode, #FarmModeNames)
    Options.StatMode = clampIndex(Options.StatMode, #Config.StatKeys + 1)
    Options.HpPotion = clampIndex(Options.HpPotion, #Config.Potions.Health)
    Options.MpPotion = clampIndex(Options.MpPotion, #Config.Potions.Mana)
    Options.BuyPotion = clampIndex(Options.BuyPotion, #Config.Potions.Health + #Config.Potions.Mana)
    Options.SellMaxRarity = clampIndex(Options.SellMaxRarity, #Config.SellRarities)
    Options.DungeonId = clampIndex(Options.DungeonId, #Config.DungeonIds)
    Options.DungeonMode = clampIndex(Options.DungeonMode, #Config.DungeonModes)
    Options.CodesText = tostring(Options.CodesText)
    return true
end

