local espGuis = {}

function clearEsp()
    for model, gui in pairs(espGuis) do
        gui:Destroy()
        espGuis[model] = nil
    end
end

local function ensureEsp(model, tag, color, myPos)
    local gui = espGuis[model]
    if gui == nil or gui.Parent == nil then
        local root = getRoot(model)
        gui = Instance.new("BillboardGui")
        gui.AlwaysOnTop = true
        gui.Size = UDim2.fromOffset(160, 32)
        gui.StudsOffset = Vector3.new(0, 3, 0)
        gui.Adornee = root
        local label = Instance.new("TextLabel")
        label.Name = "L"
        label.BackgroundTransparency = 1
        label.Size = UDim2.fromScale(1, 1)
        label.TextColor3 = color
        label.TextStrokeTransparency = 0
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold
        label.Parent = gui
        gui.Parent = root
        espGuis[model] = gui
    end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local dist = myPos and (getRoot(model).Position - myPos).Magnitude or 0
    gui.L.Text = string.format("%s [%d] %dm", tag, hum and math.floor(hum.Health) or 0, math.floor(dist))
end

spawnGuarded("esp", function()
    while alive do
        local seen = {}
        local count = 0
        local _, myRoot = localChar()
        local myPos = myRoot and myRoot.Position or nil
        if State.EspPlayers then
            for _, char in ipairs(livePlayerChars()) do
                if count < Tune.MaxEspTargets then
                    ensureEsp(char, char.Name, Color3.fromRGB(80, 200, 255), myPos)
                    seen[char] = true
                    count = count + 1
                end
            end
        end
        if State.EspNpcs then
            for _, model in ipairs(liveNpcs()) do
                if count < Tune.MaxEspTargets then
                    ensureEsp(model, model.Name, Color3.fromRGB(255, 120, 120), myPos)
                    seen[model] = true
                    count = count + 1
                end
            end
        end
        for model, gui in pairs(espGuis) do
            if not seen[model] then
                gui:Destroy()
                espGuis[model] = nil
            end
        end
        task.wait(0.25)
    end
end)

