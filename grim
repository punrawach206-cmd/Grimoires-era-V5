StepperRanges = {}
function addStepper(page, label, key, minV, maxV, step, fmt, store, onChange, idOverride)
    store = store or Tune
    if store == Tune then
        StepperRanges[key] = { minV, maxV }
    end
    local id = idOverride or (page.Name .. "/" .. label)
    registerSetting(page, id, label, function(p)
        addStepper(p, label, key, minV, maxV, step, fmt, store, onChange, id)
    end)
    local row = makeRow(page)
    local nameLabel = makeLabel(row, label, textSize, C.text, false)
    nameLabel.Position = UDim2.fromOffset(10, 0)
    nameLabel.Size = UDim2.new(1, -200, 1, 0)
    addStar(row, id, -182)

    local function stepButton(symbol, xOffset)
        local b = Instance.new("TextButton")
        b.Size = UDim2.fromOffset(34, 30)
        b.Position = UDim2.new(1, xOffset, 0.5, -15)
        b.BackgroundColor3 = C.bg
        b.BorderSizePixel = 0
        b.Font = Enum.Font.GothamBold
        b.TextSize = textSize + 3
        b.TextColor3 = C.text
        b.Text = symbol
        b.Parent = row
        corner(b, 8)
        stroke(b)
        return b
    end
    local minus = stepButton("-", -152)
    local plus = stepButton("+", -42)

    local valueLabel = makeLabel(row, "", textSize, C.red, true)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Center
    valueLabel.Position = UDim2.new(1, -114, 0, 0)
    valueLabel.Size = UDim2.fromOffset(70, rowH)

    local function paint()
        valueLabel.Text = string.format(fmt, store[key])
    end
    local function bump(delta)
        local v = math.clamp(store[key] + delta, minV, maxV)
        v = math.floor(v / step + 0.5) * step
        store[key] = math.clamp(v, minV, maxV)
        paint()
        if onChange then onChange(store[key]) end
    end
    minus.MouseButton1Click:Connect(function() bump(-step) end)
    plus.MouseButton1Click:Connect(function() bump(step) end)
    register(page, paint)
    paint()
end

