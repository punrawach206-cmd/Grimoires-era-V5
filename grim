track(Workspace.DescendantAdded:Connect(trackPrompt))

local function promptPosition(prompt)
    local parent = prompt.Parent
    if parent and parent:IsA("BasePart") then
        return parent.Position
    elseif parent and parent:IsA("Attachment") then
        return parent.WorldPosition
    elseif parent and parent:IsA("Model") then
        return parent:GetPivot().Position
    end
    return nil
end

local function chestStopped()
    return not (alive and State.AutoChest)
end

local function waitUntil(predicate, timeout)
    local t0 = os.clock()
    while os.clock() - t0 < timeout do
        if chestStopped() or predicate() then
            return predicate()
        end
        task.wait(0.05)
    end
    return predicate()
end

local function flyTo(cf, timeout)
    Mover.goal = cf
    return waitUntil(function()
        local _, root = localChar()
        return root ~= nil and (root.Position - cf.Position).Magnitude <= 1.5
    end, timeout)
end

local function holdPrompt(prompt)
    pcall(function()
        prompt:InputHoldBegin()
        task.wait(math.max(prompt.HoldDuration, 0) + 0.2)
        prompt:InputHoldEnd()
    end)
end

local function collectPrompt(prompt, isDone)
    local pos = promptPosition(prompt)
    if pos == nil or not prompt.Enabled then
        return false, "prompt missing or disabled"
    end
    if not flyTo(CFrame.new(pos + Vector3.new(0, 3, 0)), 40) then
        return false, "could not reach the chest"
    end
    task.wait(0.2)
    if type(fireproximityprompt) == "function" then
        pcall(fireproximityprompt, prompt)
    end
    if waitUntil(isDone, 1.0) then return true end
    holdPrompt(prompt)
    if waitUntil(isDone, Config.ChestOpenDelaySeconds + 2) then return true end
    return false, "chest still closed after the open delay"
end

local chestFailures = {}

spawnGuarded("chest", function()
    while alive do
        if State.AutoChest then
            local opened, failed, lastReason = 0, 0, nil
            local jobs = {}
            local _, root = localChar()
            local rootPos = root and root.Position or Vector3.zero
            local folder = resolve(Config.MapChestFolder)
            if root and folder then
                for _, chest in ipairs(folder:GetChildren()) do
                    local taken = chest:GetAttribute(Config.MapChestTakenAttribute) == true
                    if not taken and (chestFailures[chest] or 0) < Tune.ChestMaxTries then
                        local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then
                            table.insert(jobs, {
                                key = chest, prompt = prompt,
                                isDone = function()
                                    return chest.Parent == nil
                                        or chest:GetAttribute(Config.MapChestTakenAttribute) == true
                                end,
                            })
                        else
                            lastReason = "no ProximityPrompt under " .. chest.Name
                        end
                    end
                end
                for prompt in pairs(bossPrompts) do
                    if prompt.Parent == nil then
                        bossPrompts[prompt] = nil
                    elseif prompt.Enabled and (chestFailures[prompt] or 0) < Tune.ChestMaxTries then
                        table.insert(jobs, {
                            key = prompt, prompt = prompt,
                            isDone = function()
                                return prompt.Parent == nil or not prompt.Enabled
                            end,
                        })
                    end
                end
            end
            table.sort(jobs, function(a, b)
                local pa, pb = promptPosition(a.prompt), promptPosition(b.prompt)
                local da = pa and (pa - rootPos).Magnitude or math.huge
                local db = pb and (pb - rootPos).Magnitude or math.huge
                return da < db
            end)
            if #jobs > 0 then
                Activity.chestBusy = true
            end
            for _, job in ipairs(jobs) do
                if chestStopped() then break end
                local ok, reason = collectPrompt(job.prompt, job.isDone)
                if ok then
                    opened = opened + 1
                    chestFailures[job.key] = nil
                else
                    failed = failed + 1
                    chestFailures[job.key] = (chestFailures[job.key] or 0) + 1
                    lastReason = reason
                end
            end
            if Activity.chestBusy then
                Activity.chestBusy = false
                Mover.goal = nil
            end
            setStatus("chest", string.format("opened %d, failed %d%s", opened, failed,
                lastReason and (" | " .. lastReason) or ""))
        end
        task.wait(jitter(Tune.ChestIntervalSeconds))
    end
end)

